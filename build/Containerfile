# Containerfile for recon-silly-ation
# Build: podman build -t recon_silly_ation:latest -f Containerfile .
# Run:   podman run --rm -it recon_silly_ation:latest
# Seal:  selur seal recon_silly_ation:latest

# --- Build stage ---
FROM cgr.dev/chainguard/wolfi-base:latest AS build

RUN apk add --no-cache zig

WORKDIR /build
COPY . .

RUN cd src/interface/ffi && zig build -Doptimize=ReleaseSafe

# --- Runtime stage ---
FROM cgr.dev/chainguard/static:latest

# Copy built FFI/WASM artifacts from the build stage
COPY --from=build /build/src/interface/ffi/zig-out/lib/ /usr/local/lib/

# Non-root user (chainguard images default to nonroot)
USER nonroot
